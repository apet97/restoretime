# PUBLIC_BASE_URL must be a public HTTPS origin. A local HTTP URL cannot be a Clockify installation target.
# Use https://developer.clockify.me for the developer environment and https://app.clockify.me for production.
# Generate a local encryption key with: openssl rand -hex 32
# The filled .env file is ignored. Never commit it.
PORT=8080
PUBLIC_BASE_URL=https://replace-with-your-https-origin.example
CLOCKIFY_PARENT_ORIGIN=https://developer.clockify.me
DATABASE_PATH=./var/restoretime.sqlite
ADDON_KEY=replace-with-your-developer-addon-key
TOKEN_ENCRYPTION_KEY=
LOG_LEVEL=info
