# Template for `.env.live`, which holds the live suite's stable credentials and is gitignored.
# Copy to `.env.live` and fill in. Never commit the filled file.
#
# CK_LIVE_API_KEY must be a **developer-environment** key: Preferences -> Advanced ->
# Manage API keys -> Generate new, on https://developer.clockify.me. The value is shown once.
# Confirm which environment a key belongs to before using it — a production key authenticates
# against api.clockify.me and is rejected 401 by the developer environment, and vice versa:
#
#   curl -s -o /dev/null -w '%{http_code}\n' -H "X-Api-Key: <key>" https://developer.clockify.me/api/v1/user
#   curl -s -o /dev/null -w '%{http_code}\n' -H "X-Api-Key: <key>" https://api.clockify.me/api/v1/user
#
# The live suite creates and deletes real time entries. It accepts only this explicit target.
CK_LIVE_TARGET=developer

# CK_LIVE_WS is the sacrificial developer workspace. CK_LIVE_API_USER_ID is the exact user that
# owns CK_LIVE_API_KEY. Confirm both IDs before each run. They are blank because this committed
# template must not encode an environment-specific target.
CK_LIVE_API_KEY=
CK_LIVE_API_USER_ID=
CK_LIVE_WS=
CK_LIVE_API_BASE=https://developer.clockify.me/api
CK_LIVE_ADDON_ID=
CK_LIVE_ADDON_KEY=restoretime

# Release-only Railway identity and operator receipts. Use the full 40-character merged commit as
# CK_LIVE_CANDIDATE_ID. Copy the five Railway IDs from the exact new deployment. The project,
# environment, and service names must each be `restoretime`. Keep receipt JSON outside the
# repository. Run `test:live:trigger` first,
# then copy its printed source ID here and into the LV-02B receipt.
# LV-01B must set deletedEntryListLoaded and contentSecurityPolicyVerified true, record the icon
# and developer CSP origin, and set both error counts to zero. LV-02B must record correlated
# Railway webhook logs and the exact source row in remote SQLite. See docs/13 for all JSON fields.
CK_LIVE_CANDIDATE_ID=
CK_RAILWAY_PROJECT_ID=
CK_RAILWAY_ENVIRONMENT_ID=
CK_RAILWAY_SERVICE_ID=
CK_RAILWAY_DEPLOYMENT_ID=
CK_RAILWAY_DEPLOYMENT_INSTANCE_ID=
CK_LIVE_LV01B_RECEIPT=
CK_LIVE_LV02_SOURCE_ID=
CK_LIVE_LV02B_RECEIPT=

# Not stored here, and why:
#   CK_LIVE_ADDON_TOKEN     — handed off encrypted from the exact Railway deployment
#   CK_LIVE_ADDON_BASE_URL  — pass the exact Railway public origin as $1
